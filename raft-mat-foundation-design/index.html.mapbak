padding-top: 0 !important;
}</style><style>/*afx*//* cat-sub-wrap: full width abajo */
.cat-sub-wrap, .cat-sub, .nav-cat-sub {
flex-basis: 100% !important;
width: 100% !important;
max-width: 100% !important;
