.card { background: #FFF; border: 1px solid #E5E7EB; border-radius: 10px; padding: 1.2rem; text-decoration: none; color: inherit; box-shadow: 0 1px 2px rgba(0,0,0,.04); transition: all .2s; }
/* Header */
.header, .main-header, header.main-header { background: #0F172A; color: #FFF; padding: 1rem 1.5rem; margin-bottom: 1.5rem; }
.sb-home a, .sidebar a, aside a { color: #FFFFFF; text-decoration: none; display: block; padding: .5rem .75rem; border-radius: 6px; transition: background .15s; }
/* Layout wrapper */
.layout, .main-wrapper, .content-area { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
#mapa-ciudad { width: 100%; height: 380px; border-radius: 8px; }
.sb-home a:hover, .sidebar a:hover { background: rgba(255,255,255,.08); }
.block > div { max-width: 1200px; margin: 0 auto; }
footer a, .footer a { color: #FCD34D; }
.cat-sub a { font-size: .85rem; color: rgba(255,255,255,.85); padding: .3rem .75rem; }
.brand, .brand-text, .brand-name { color: #FFFFFF; font-weight: 700; font-size: 1.25rem; line-height: 1.1; }
/* Sidebar */
.sb-home, .sidebar, aside { background: #1E293B; color: #FFFFFF; border-radius: 10px; padding: 1rem; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; margin: 0; line-height: 1.6; color: #1E293B; background: #F8FAFC; }
/* Cards / grid */
.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
.cat-name { color: #FFFFFF; font-weight: 500; flex: 1; }
/* Authority refs */
.authority-refs { color: #94A3B8; font-size: .8rem; }
h3 { color: #1E293B; font-size: 1.1rem; margin: 1rem 0 .5rem; }
.updated-info { color: #94A3B8; font-size: .8rem; font-style: italic; }
h2 { color: #1E293B; font-size: 1.35rem; margin: 1.5rem 0 .8rem; font-weight: 700; }
.cat-row, .cat-item { display: flex; align-items: center; justify-content: space-between; padding: .4rem .75rem; }
.map-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
/* Breadcrumb / crumb */
.crumb-7fe1, .breadcrumb { padding: .5rem 0; font-size: .85rem; color: rgba(255,255,255,.85); }
.cat-toggle, .cat-arrow { background: transparent; border: 0; color: #FFFFFF; cursor: pointer; padding: .2rem .4rem; }
a { color: #1D4ED8; }
/* Reset basico */
* { box-sizing: border-box; }
.card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,.08); border-color: #1D4ED8; }
/* Mid CTA */
.mid-cta-7fe1 { padding: 2rem 0; }
/* Body wrapper - layout flex */
.layout { display: grid; grid-template-columns: 240px 1fr; gap: 1.5rem; margin: 1.5rem auto; padding: 0 1.5rem; max-width: 1280px; }
.mid-cta-7fe1 > div { max-width: 720px; margin: 0 auto; background: linear-gradient(135deg, #1D4ED815, #1D4ED808); border-left: 4px solid #1D4ED8; padding: 1.6rem 1.8rem; border-radius: 8px; text-align: center; }
.brand-logo { display: inline-block; vertical-align: middle; }</style><style>/*afx*//* Sidebar sticky pero NO encima del header */
.sb-home, aside.sidebar, .sidebar, aside {
position: sticky !important;
